# Copy this to .env for local dev, or paste each line into Render's
# "Environment" tab as separate key/value pairs. Never commit a real .env.

# Get a free API key at https://console.groq.com (API Keys -> Create API Key)
GROQ_API_KEY=gsk_your_key_here

# Optional: comma-separated fallback chain of Groq models, tried in order.
# Leave unset to use the default list in app/main.py.
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.6-27b,qwen/qwen3.8-27b

# Optional: set to true to skip the Groq call (used for load testing only)
# MOCK_MODE=false

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=https://bantay-bait.vercel.app,http://localhost:3000
