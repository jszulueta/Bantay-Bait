# Copy this to .env for local dev, or paste each line into Render's
# "Environment" tab as separate key/value pairs. Never commit a real .env.

# Get a free token at https://huggingface.co/settings/tokens (read access is enough)
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Multilingual zero-shot NLI model (free, no fine-tuning required, handles Taglish)
HF_MODEL=joeddav/xlm-roberta-large-xnli
ZERO_SHOT=true

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=https://bantay-bait.vercel.app,http://localhost:3000
